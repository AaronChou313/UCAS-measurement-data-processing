{
  "name": "ucas-measurement-data-processing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:prepare": "node scripts/prepare-site.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev",
    "docs:build": "npm run docs:prepare && vitepress build && node scripts/check-site.mjs",
    "docs:preview": "vitepress preview",
    "check:sources": "python3 scripts/check_sources.py",
    "test:visualizations": "node --test tests/visualizations.test.mjs tests/visualization-svg.test.mjs",
    "figures:check": "node scripts/build-teaching-figures.mjs --check",
    "check:visualization-pages": "node scripts/check-visualization-pages.mjs"
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "markdown-it-mathjax3": "4.3.2",
    "markdown-it-task-lists": "2.1.1"
  },
  "overrides": {
    "vite": "6.4.4",
    "@xmldom/xmldom": "0.9.12"
  }
}
